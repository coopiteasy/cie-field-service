<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.fsm.person</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_social_service.view_partner_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='social_volunteer_properties']"
                position="before"
            >
                <field invisible="not fsm_person" name="fsm_person_id" readonly="1" />
            </xpath>
        </field>
    </record>
</odoo>
